# The profile directory publishes README, agent instructions, topic documents, and an empty example only.
/profile/*
!/profile/README.md
!/profile/AGENTS.md
!/profile/configuration.md
!/profile/fields.md
!/profile/maintenance.md
!/profile/example.json

# Optional personal configurations elsewhere in this repository.
*.local.*
.env
.env.*
!.env.example

# Editor and temporary copies.
*.bak
*.tmp
*~

# Local rule-check environments, caches, test batches, and reports.
/tools/rule-check/venv/
/tools/rule-check/.venv/
/build/
/tmp/
